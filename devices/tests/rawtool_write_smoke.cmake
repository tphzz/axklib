cmake_minimum_required(VERSION 3.21)
if(NOT EXISTS "${RAWDISK_TOOL}" OR NOT EXISTS "${PROBE_FIXTURE}" OR NOT RAWDISK_TEST_DIRECTORY)
    message(FATAL_ERROR "rawtool, fixture producer and isolated directory are required")
endif()
file(REMOVE_RECURSE "${RAWDISK_TEST_DIRECTORY}")
file(MAKE_DIRECTORY "${RAWDISK_TEST_DIRECTORY}")
set(image "${RAWDISK_TEST_DIRECTORY}/fixture.img")
set(plan "${RAWDISK_TEST_DIRECTORY}/fixture.plan")
set(journal "${RAWDISK_TEST_DIRECTORY}/journal")
string(REPEAT "0" 65536 data)
file(WRITE "${image}" "${data}")
file(SHA256 "${image}" before)
execute_process(COMMAND "${PROBE_FIXTURE}" "${image}" "${plan}" RESULT_VARIABLE result TIMEOUT 20)
if(NOT result STREQUAL "0")
    message(FATAL_ERROR "fixture plan failed")
endif()
file(TO_CMAKE_PATH "${image}" image)
string(HEX "${image}" hex)
string(REGEX REPLACE "(..)" "%\\1" encoded "${hex}")
set(locator "image?image.path=${encoded}&image.sector_size=512")
execute_process(COMMAND "${RAWDISK_TOOL}" probe-write "${locator}" --plan "${plan}" --journal "${journal}" --no-prompt
    RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error TIMEOUT 20)
if(NOT result STREQUAL "0" OR NOT output MATCHES "Pattern verified: yes" OR NOT output MATCHES "Restored and guards verified: yes")
    message(FATAL_ERROR "image probe failed: ${output}\n${error}")
endif()
execute_process(COMMAND "${RAWDISK_TOOL}" recover-write --journal "${journal}" --no-prompt
    RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error TIMEOUT 20)
if(NOT result STREQUAL "0" OR NOT output MATCHES "Already restored")
    message(FATAL_ERROR "no-op recovery failed: ${output}\n${error}")
endif()
foreach(target IN ITEMS "${locator}" "raw?device.device=DO_NOT_OPEN_HARDWARE")
    execute_process(COMMAND "${RAWDISK_TOOL}" probe-write "${target}" --plan "${plan}" --journal "${journal}-refused" --yes --no-prompt
        RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error TIMEOUT 20)
    if(NOT result STREQUAL "1" OR NOT error MATCHES "--yes is not allowed")
        message(FATAL_ERROR "--yes was not refused before opening: ${output}\n${error}")
    endif()
endforeach()
execute_process(COMMAND "${RAWDISK_TOOL}" probe-write "raw?device.device=DO_NOT_OPEN_HARDWARE"
    --plan "${plan}" --journal "${journal}-refused" --no-prompt
    RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error TIMEOUT 20)
if(NOT result STREQUAL "1" OR NOT error MATCHES "interactive console")
    message(FATAL_ERROR "physical noninteractive probe was not refused before opening: ${output}\n${error}")
endif()
execute_process(COMMAND "${RAWDISK_TOOL}" probe-write "${locator}" --plan "${plan}" --journal "${journal}" --no-prompt
    RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error TIMEOUT 20)
if(NOT result STREQUAL "1" OR output MATCHES "Write attempted: yes")
    message(FATAL_ERROR "existing journal was not refused: ${output}\n${error}")
endif()
execute_process(COMMAND "${PROBE_FIXTURE}" "${image}" "${plan}" "${locator}" "${journal}-recovery"
    RESULT_VARIABLE result TIMEOUT 20)
if(NOT result STREQUAL "0")
    message(FATAL_ERROR "interrupted image fixture failed")
endif()
# Changed geometry must refuse recovery without changing even this disposable file.
file(APPEND "${image}" "${data}")
file(SHA256 "${image}" changed_geometry)
execute_process(COMMAND "${RAWDISK_TOOL}" recover-write --journal "${journal}-recovery" --no-prompt
    RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error TIMEOUT 20)
file(SHA256 "${image}" refused_geometry)
if(NOT result STREQUAL "1" OR NOT error MATCHES "identity/geometry" OR NOT changed_geometry STREQUAL refused_geometry)
    message(FATAL_ERROR "recovery did not refuse changed geometry: ${output}\n${error}")
endif()
file(READ "${image}" modified LIMIT 65536)
file(WRITE "${image}" "${modified}")
execute_process(COMMAND "${RAWDISK_TOOL}" recover-write --journal "${journal}-recovery" --no-prompt
    RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error TIMEOUT 20)
if(NOT result STREQUAL "0" OR NOT output MATCHES "Write attempted: yes" OR NOT output MATCHES "Restored and guards verified: yes")
    message(FATAL_ERROR "modified-sector recovery failed: ${output}\n${error}")
endif()
file(SHA256 "${image}" after)
if(NOT before STREQUAL after OR EXISTS "${journal}-refused")
    message(FATAL_ERROR "fixture contents changed or a refused command created a journal")
endif()
file(REMOVE_RECURSE "${RAWDISK_TEST_DIRECTORY}")
message(STATUS "Image-only CLI probe, recovery and pre-open hardware refusals passed")
