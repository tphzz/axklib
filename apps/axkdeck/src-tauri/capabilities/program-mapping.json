{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "program-mapping",
  "description": "Mapping Editor display and scaling; object changes are relayed to the main editor.",
  "windows": ["mapping-program", "mapping-sample", "mapping-bank", "mapping-members"],
  "permissions": [
    "core:default",
    "core:webview:allow-set-webview-zoom",
    "core:window:allow-set-min-size",
    "core:window:allow-set-size",
    "core:window:allow-show",
    "log:default"
  ]
}
