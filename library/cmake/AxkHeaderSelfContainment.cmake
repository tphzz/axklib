include_guard(GLOBAL)

function(axk_add_header_self_containment_target target)
  set(options)
  set(one_value_args CXX_STANDARD)
  set(multi_value_args HEADERS INCLUDE_DIRECTORIES LINK_LIBRARIES)
  cmake_parse_arguments(AXK_HEADER "${options}" "${one_value_args}" "${multi_value_args}" ${ARGN})

  if(NOT AXK_HEADER_HEADERS)
    message(FATAL_ERROR "${target} has no headers to check")
  endif()
  if(NOT AXK_HEADER_CXX_STANDARD)
    set(AXK_HEADER_CXX_STANDARD 23)
  endif()

  set(generated_sources)
  foreach(header IN LISTS AXK_HEADER_HEADERS)
    cmake_path(ABSOLUTE_PATH header NORMALIZE OUTPUT_VARIABLE absolute_header)
    if(NOT EXISTS "${absolute_header}")
      message(FATAL_ERROR "${target} header does not exist: ${absolute_header}")
    endif()
    string(REGEX REPLACE "^.*[/\\\\]include[/\\\\]" "" include_name "${absolute_header}")
    if(include_name STREQUAL absolute_header)
      message(FATAL_ERROR "${target} header is not below an include directory: ${absolute_header}")
    endif()
    string(MAKE_C_IDENTIFIER "${include_name}" source_stem)
    set(source "${CMAKE_CURRENT_BINARY_DIR}/header-self-containment/${target}/${source_stem}.cpp")
    file(GENERATE OUTPUT "${source}" CONTENT "#include <${include_name}>\n")
    list(APPEND generated_sources "${source}")
  endforeach()

  add_library(${target} OBJECT ${generated_sources})
  target_compile_features(${target} PRIVATE cxx_std_${AXK_HEADER_CXX_STANDARD})
  target_include_directories(${target} PRIVATE ${AXK_HEADER_INCLUDE_DIRECTORIES})
  target_link_libraries(${target} PRIVATE ${AXK_HEADER_LINK_LIBRARIES})
  set_target_properties(${target} PROPERTIES CXX_EXTENSIONS OFF)
  axk_set_project_warnings(${target})
endfunction()
